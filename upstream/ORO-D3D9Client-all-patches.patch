+void D3D9ParticleStream::OroGetSpec(PARTICLESTREAMSPEC* out, VECTOR3* outPos, VECTOR3* outDir) const
+{
+	if (outPos) *outPos = pos ? *pos : _V(0,0,0);
+	if (outDir) *outDir = dir ? *dir : _V(0,0,0);
+	if (!out) return;
