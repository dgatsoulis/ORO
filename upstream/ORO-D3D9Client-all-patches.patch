+{
+	g_gcSurfaceWet = (wet < 0.0f) ? 0.0f : (wet > 1.0f ? 1.0f : wet);
+}
+
+// ORO patch (s) part 2. Clamped: the shaders lerp lighting terms by it, and outside 0..1
+// it would invert the sun or overdrive the ambient.
