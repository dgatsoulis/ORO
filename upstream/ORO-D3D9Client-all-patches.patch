+	mW._21 = (float)r1.x; mW._22 = (float)r1.y; mW._23 = (float)r1.z;
+	mW._31 = (float)r2.x; mW._32 = (float)r2.y; mW._33 = (float)r2.z;
+	mW._41 = (float)o.x;  mW._42 = (float)o.y;  mW._43 = (float)o.z;
