+void gcCore::SetFogLook(float brightness, float sunGlow)
+{
+	g_gcFogBright  = (brightness < 0.0f) ? 0.0f : (brightness > 3.0f ? 3.0f : brightness);
+	g_gcFogSunGlow = (sunGlow    < 0.0f) ? 0.0f : (sunGlow    > 3.0f ? 3.0f : sunGlow);
+}
