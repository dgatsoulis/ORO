+{
+	MATRIX3 R; VECTOR3 P;
+	oapiGetRotationMatrix(t.hPlanet, &R);
+	oapiGetGlobalPos(t.hPlanet, &P);
+	const VECTOR3 o = _V(mW._41, mW._42, mW._43) + cam - P;      // tile origin, global, relative to the planet centre
+	t.lpos    = tmul(R, o);
