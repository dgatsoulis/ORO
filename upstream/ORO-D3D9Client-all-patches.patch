+float g_oroVCNightNow = 1.0f;
+static D3D9MatExt s_oroNightMat;
+static const D3D9MatExt* OroVCNightMat(const D3D9MatExt* mat)
+{
+	if (g_oroVCNightNow >= 0.999f) return mat;
+	// Part 2 (2026-09-17, a tester's DG at night: instrument lights ON, the MFD button
+	// labels unreadable while the gimbal and hover labels lit up). The DG's switch writes
+	// TWO materials through oapiSetMaterial: the labels (material 11) as diffuse 0 /
+	// emissive (0.35,1,0.35) - a display by the test below, spared - and the MFD buttons
+	// (material 0) as diffuse 1.0 / emissive 0.6, which the test reads as a wall and
+	// dims. No static property tells those two apart: what does is that the VESSEL is
+	// driving the material. A material the vessel writes at runtime is a lamp somebody
+	// switched, so it keeps whatever emissive the vessel gave it - ON (0.6) and OFF
+	// (0.15, the DG's authored "unlit" level) alike.
+	if (mat->ModFlags & D3D9MATEX_RUNTIME) return mat;
+	float dmax = mat->Diffuse.x;
