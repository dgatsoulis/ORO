+static bool IsGroupBox(HWND h)
+{
+	char cls[32] = "";
+	GetClassNameA(h, cls, sizeof(cls));
+	if (_stricmp(cls, "Button") != 0) return false;
+	return (GetWindowLong(h, GWL_STYLE) & BS_TYPEMASK) == BS_GROUPBOX;
+}
+
+// A label shares the dialog-wide IDC_STATIC, so it is matched to its control
+// by position: the nearest mapped control on the same row and to the right, or
+// failing that the nearest mapped control BELOW it (every label that is not on
+// its control's row sits above the control in this dialog - "Lower/Higher" over
+// Texture Bias, "Sharp/Smooth" over Mipmap Bias, "Point light shadows" over its
+// combo). Controls above a label are never its target.
+static HWND NearestMapped(HWND hDlg, HWND hLabel)
+{
+	RECT rl; GetWindowRect(hLabel, &rl);
+	const long lcy = (rl.top + rl.bottom) / 2;
+	HWND best = NULL; long bestScore = 0x7fffffff;
+	for (HWND c = GetWindow(hDlg, GW_CHILD); c; c = GetWindow(c, GW_HWNDNEXT)) {
+		if (c == hLabel) continue;
+		if (!(GetWindowLong(c, GWL_STYLE) & WS_VISIBLE)) continue;
+		if (!FindEntry(GetDlgCtrlID(c))) continue;
+		RECT rc; GetWindowRect(c, &rc);
+		long dx = 0;
+		if (rc.left >= rl.right) dx = rc.left - rl.right;
+		else if (rc.right <= rl.left) dx = rl.left - rc.right;
+		long score;
+		if (lcy >= rc.top && lcy <= rc.bottom) score = dx;                       // same row
+		else if (rc.top >= lcy) score = 1000 + (rc.top - lcy) * 4 + dx * 2;     // below the label
+		else continue;                                                           // above: never
+		if (score < bestScore) { bestScore = score; best = c; }
+	}
+	return best;
+}
