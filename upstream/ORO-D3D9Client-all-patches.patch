+// ---------------------------------------------------------------------------
+// The popup
+//
+// TWO RULES, both bought with the first flight (2026-09-15: "I click on any
+// setting and I get nothing", "F1 ... a very quick blinking"):
+//   1. NOTHING IS SHOWN INSIDE THE WM_HELP CALL. In "?" mode the message is
+//      delivered from INSIDE the system's own help-mode loop, which still holds
+//      the mouse capture and releases it on the way out; anything created in the
+//      handler is torn down by that unwinding (a window that took capture lost
+//      it; a window that took focus lost it to the dialog manager's cleanup).
+//      So the handler only records the HELPINFO and posts WM_ORO_SETUPHELP to
+//      the dialog; the popup is created when that message is processed, after
+//      the help mode and the key handling have fully unwound.
+//   2. THE POPUP NEVER TAKES THE MOUSE CAPTURE. It takes keyboard focus (so any
+//      key closes it) and closes on losing focus or activation - a click on the
+//      dialog activates the dialog, which is the dismissal - plus a 120 ms
+//      timer that watches the physical mouse buttons as a backstop, armed only
+//      after every button has been seen UP once (the click that opened it must
+//      not close it).
+// Every open and close writes ONE line to Orbiter.log naming the reason, so a
+// popup that vanishes on a machine we cannot see diagnoses itself.
+//
+// FONTS (2026-09-16, "the popup is hardly readable"): the dialog's own face is
+// MS Sans Serif 8 pt, sized for a form of sixty controls, not for reading. The
+// popup and the help window take Segoe UI at 1.45x the dialog font's pixel
+// height (about 12 pt at 96 dpi), bold at 1.55x for entry titles and 1.75x for
+// group headings - derived from the dialog font so they follow its DPI.
+// ---------------------------------------------------------------------------
+
+static HFONT MakeFont(HWND hDlg, double scale, bool bold)
+{
+	HFONT base = (HFONT)SendMessage(hDlg, WM_GETFONT, 0, 0);
+	if (!base) base = (HFONT)GetStockObject(DEFAULT_GUI_FONT);
+	LOGFONTA lf; ZeroMemory(&lf, sizeof(lf));
+	GetObjectA(base, sizeof(lf), &lf);
+	int h = (lf.lfHeight < 0) ? -lf.lfHeight : lf.lfHeight;
+	if (h <= 0) h = 11;
+	lf.lfHeight = -(int)(h * scale + 0.5);
+	lf.lfWidth = 0;
+	lf.lfWeight = bold ? FW_BOLD : FW_NORMAL;
+	lf.lfQuality = CLEARTYPE_QUALITY;
+	strcpy_s(lf.lfFaceName, sizeof(lf.lfFaceName), "Segoe UI");
+	return CreateFontIndirectA(&lf);
+}
+
+// The dialog font's pixel height - the one number every size here derives from.
+static int DialogFontPx(HWND hDlg)
+{
+	HFONT base = (HFONT)SendMessage(hDlg, WM_GETFONT, 0, 0);
+	if (!base) base = (HFONT)GetStockObject(DEFAULT_GUI_FONT);
+	LOGFONTA lf; ZeroMemory(&lf, sizeof(lf));
+	GetObjectA(base, sizeof(lf), &lf);
+	int h = (lf.lfHeight < 0) ? -lf.lfHeight : lf.lfHeight;
+	return (h <= 0) ? 11 : h;
+}
+
+static const double s_bodyScale = 1.45, s_titleScale = 1.55, s_headScale = 1.75;
+
+static const char* const s_className = "OroSetupHelpPopup";
+static const UINT_PTR s_timerId = 1;
+static HWND   s_hPopup = NULL;
+static HWND   s_hRestoreFocus = NULL;
+static HFONT  s_hFont = NULL;       // owned (Segoe UI, 1.45x the dialog font)
+static HFONT  s_hFontBold = NULL;   // owned
+static const char* s_title = NULL;
+static const char* s_text = NULL;
+static int    s_pad = 6, s_gap = 3, s_titleH = 0;
+static bool   s_closing = false;
+static bool   s_buttonsSeenUp = false;
+static HELPINFO s_pending;
+static bool   s_pendingValid = false;
+
+static bool AnyMouseButtonDown()
+{
+	return ((GetAsyncKeyState(VK_LBUTTON) | GetAsyncKeyState(VK_RBUTTON) | GetAsyncKeyState(VK_MBUTTON)) & 0x8000) != 0;
+}
+
+static void PopupClose(const char* why)
+{
+	if (s_closing) return;
+	s_closing = true;
+	HWND h = s_hPopup; s_hPopup = NULL;
+	if (h && IsWindow(h)) {
+		KillTimer(h, s_timerId);
+		DestroyWindow(h);
+		if (why) oapiWriteLogV("D3D9: ORO setup help - popup closed (%s)", why);
+	}
+	if (s_hFontBold) { DeleteObject(s_hFontBold); s_hFontBold = NULL; }
+	if (s_hFont)     { DeleteObject(s_hFont);     s_hFont = NULL; }
+	if (s_hRestoreFocus && IsWindow(s_hRestoreFocus)) SetFocus(s_hRestoreFocus);
+	s_hRestoreFocus = NULL;
+	s_closing = false;
+}
+
+static LRESULT CALLBACK PopupProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
+{
+	switch (uMsg) {
+	case WM_PAINT: {
+		PAINTSTRUCT ps; HDC hdc = BeginPaint(hWnd, &ps);
+		RECT rc; GetClientRect(hWnd, &rc);
+		HBRUSH hbr = CreateSolidBrush(GetSysColor(COLOR_INFOBK));
+		FillRect(hdc, &rc, hbr); DeleteObject(hbr);
+		SetBkMode(hdc, TRANSPARENT);
+		SetTextColor(hdc, GetSysColor(COLOR_INFOTEXT));
+		RECT rt = { rc.left + s_pad, rc.top + s_pad, rc.right - s_pad, rc.bottom - s_pad };
+		HGDIOBJ old = SelectObject(hdc, s_hFontBold ? s_hFontBold : s_hFont);
+		if (s_title) DrawTextA(hdc, s_title, -1, &rt, DT_LEFT | DT_TOP | DT_WORDBREAK | DT_NOPREFIX);
+		SelectObject(hdc, s_hFont);
+		rt.top += s_titleH + s_gap;
+		if (s_text) DrawTextA(hdc, s_text, -1, &rt, DT_LEFT | DT_TOP | DT_WORDBREAK | DT_NOPREFIX);
+		SelectObject(hdc, old);
+		EndPaint(hWnd, &ps);
+		return 0;
+	}
+	case WM_LBUTTONDOWN: case WM_RBUTTONDOWN: case WM_MBUTTONDOWN:
+	case WM_NCLBUTTONDOWN: case WM_NCRBUTTONDOWN:
+		PopupClose("click on the popup");
+		return 0;
+	case WM_KEYDOWN: case WM_SYSKEYDOWN:
+		if (lParam & (1u << 30)) return 0;		// autorepeat of the key that opened it (F1 held down)
+		PopupClose("key pressed");
+		return 0;
+	case WM_KILLFOCUS:
+		PopupClose("focus left the popup");
+		return 0;
+	case WM_ACTIVATE:
+		if (LOWORD(wParam) == WA_INACTIVE) PopupClose("another window activated");
+		return 0;
+	case WM_TIMER:
+		if (wParam == s_timerId) {
+			if (!AnyMouseButtonDown()) s_buttonsSeenUp = true;
+			else if (s_buttonsSeenUp) {
+				POINT p; GetCursorPos(&p);
+				if (WindowFromPoint(p) != hWnd) PopupClose("click elsewhere (timer)");
+			}
+			HWND owner = GetWindow(hWnd, GW_OWNER);
+			if (owner && !IsWindow(owner)) PopupClose("dialog gone");
+		}
+		return 0;
+	case WM_DESTROY:
+		KillTimer(hWnd, s_timerId);
+		return 0;
+	case WM_MOUSEACTIVATE:
+		return MA_NOACTIVATE;
+	}
+	return DefWindowProc(hWnd, uMsg, wParam, lParam);
+}
+
+static void PopupShow(HWND hDlg, const RECT* anchor, const char* title, const char* text)
+{
+	PopupClose("replaced by a new popup");
+
+	static bool registered = false;
+	if (!registered) {
+		WNDCLASSEXA wc; ZeroMemory(&wc, sizeof(wc));
+		wc.cbSize = sizeof(wc);
+		wc.style = CS_SAVEBITS | CS_DROPSHADOW;
+		wc.lpfnWndProc = PopupProc;
+		wc.hInstance = g_hInst;
+		wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+		wc.lpszClassName = s_className;
+		registered = (RegisterClassExA(&wc) != 0) || (GetLastError() == ERROR_CLASS_ALREADY_EXISTS);
+		if (!registered) { oapiWriteLogV("D3D9: ORO setup help - popup class registration FAILED (%lu)", GetLastError()); return; }
+	}
+
+	s_title = title; s_text = text;
+
+	// Fonts: readable ones, derived from the dialog's so they follow its DPI.
+	s_hFont = MakeFont(hDlg, s_bodyScale, false);
+	s_hFontBold = MakeFont(hDlg, s_titleScale, true);
+	if (!s_hFont) s_hFont = (HFONT)GetStockObject(DEFAULT_GUI_FONT);
+
+	// Measure: wrap at ~46 average characters, clamped to a sane pixel range.
+	HDC hdc = GetDC(hDlg);
+	HGDIOBJ old = SelectObject(hdc, s_hFont);
+	TEXTMETRICA tm; GetTextMetricsA(hdc, &tm);
+	int maxW = tm.tmAveCharWidth * 46;
+	if (maxW < 300) maxW = 300; if (maxW > 640) maxW = 640;
+	s_pad = tm.tmHeight / 2 + 2; s_gap = tm.tmHeight / 4;
+	RECT rb = { 0, 0, maxW, 0 };
+	if (text) DrawTextA(hdc, text, -1, &rb, DT_CALCRECT | DT_WORDBREAK | DT_NOPREFIX);
+	SelectObject(hdc, s_hFontBold ? s_hFontBold : s_hFont);
+	RECT rt = { 0, 0, maxW, 0 };
+	if (title) DrawTextA(hdc, title, -1, &rt, DT_CALCRECT | DT_WORDBREAK | DT_NOPREFIX);
+	SelectObject(hdc, old);
+	ReleaseDC(hDlg, hdc);
+	s_titleH = rt.bottom;
+	int w = ((rb.right > rt.right) ? rb.right : rt.right) + 2 * s_pad + 2;
+	int h = s_titleH + s_gap + rb.bottom + 2 * s_pad + 2;
+
+	// Place below the anchor, left-aligned with it; above if there is no room; on the monitor.
+	MONITORINFO mi; mi.cbSize = sizeof(mi);
+	GetMonitorInfo(MonitorFromWindow(hDlg, MONITOR_DEFAULTTONEAREST), &mi);
+	const RECT& wa = mi.rcWork;
+	int x = anchor->left, y = anchor->bottom + 2;
+	if (y + h > wa.bottom) y = anchor->top - h - 2;
+	if (y < wa.top) y = wa.top;
+	if (x + w > wa.right) x = wa.right - w;
+	if (x < wa.left) x = wa.left;
+
+	s_hRestoreFocus = GetFocus();
+	s_buttonsSeenUp = false;
+	s_hPopup = CreateWindowExA(WS_EX_TOOLWINDOW | WS_EX_TOPMOST, s_className, NULL, WS_POPUP | WS_BORDER,
+	                           x, y, w, h, hDlg, NULL, g_hInst, NULL);
+	if (!s_hPopup) { oapiWriteLogV("D3D9: ORO setup help - popup creation FAILED (%lu)", GetLastError()); return; }
+	ShowWindow(s_hPopup, SW_SHOWNOACTIVATE);
+	SetFocus(s_hPopup);		// keys close it; a click on the dialog takes focus back and closes it
+	SetTimer(s_hPopup, s_timerId, 120, NULL);
+	oapiWriteLogV("D3D9: ORO setup help - popup shown for '%s' at %d,%d (%d x %d), focus %s",
+	              title ? title : "?", x, y, w, h, (GetFocus() == s_hPopup) ? "taken" : "NOT taken");
+}
+
+// ---------------------------------------------------------------------------
+// The help window - every entry as one document, in the dialog's own layout
+// order. Built at open time by WALKING THE LIVE DIALOG: each group box's
+// rectangle claims the controls inside it, groups run left column, middle,
+// right, controls top to bottom within a group, and whatever sits outside
+// every group box (the right-hand checkboxes, the buttons) closes the document
+// under "Other settings". So the document reorders itself when the dialog does
+// and the table never has to carry a layout of its own. Owned by the dialog,
+// modeless, resizable; a read-only rich edit does the reflow and scrolling;
+// size and position are remembered for the Launchpad's lifetime.
+// ---------------------------------------------------------------------------
+
+#include <richedit.h>
+#include <string>
+#include <vector>
+#include <algorithm>
+
+static const char* const s_winClass = "OroSetupHelpWindow";
+static HWND s_hWin = NULL;
+static HWND s_hEdit = NULL;
+static RECT s_winRect = { 0, 0, 0, 0 };		// remembered size + position, this Launchpad run
+
+static const SetupHelpEntry* FindEntryDirect(int id)		// no alias resolution: readouts must not duplicate their slider
+{
+	for (size_t i = 0; i < sizeof(g_entries) / sizeof(g_entries[0]); i++)
+		if (g_entries[i].id == id) return &g_entries[i];
+	return NULL;
+}
+
+static void RtfEscape(std::string& out, const char* s)
+{
+	for (; s && *s; s++) {
+		if (*s == '\\' || *s == '{' || *s == '}') out += '\\';
+		out += *s;
+	}
+}
+
+struct HelpItem { RECT r; const SetupHelpEntry* e; };
+struct HelpBox  { RECT r; std::string caption; std::vector<HelpItem> items; };
+
+static bool BoxBefore(const HelpBox& a, const HelpBox& b)
+{
+	// column-major: a box clearly to the left comes first; within a column, top first
+	if (a.r.left + 40 < b.r.left) return true;
+	if (b.r.left + 40 < a.r.left) return false;
+	return a.r.top < b.r.top;
+}
+static bool ItemBefore(const HelpItem& a, const HelpItem& b)
+{
+	if (a.r.top + 4 < b.r.top) return true;
+	if (b.r.top + 4 < a.r.top) return false;
+	return a.r.left < b.r.left;
+}
+
+static std::string BuildHelpRtf(HWND hDlg, int bodyHalfPt, int headHalfPt)
+{
+	std::vector<HelpBox> boxes;
+	std::vector<HelpItem> loose;
+	for (HWND c = GetWindow(hDlg, GW_CHILD); c; c = GetWindow(c, GW_HWNDNEXT)) {
+		if (!IsGroupBox(c)) continue;
+		HelpBox b; GetWindowRect(c, &b.r);
+		char cap[128] = ""; GetWindowTextA(c, cap, sizeof(cap)); b.caption = cap;
+		boxes.push_back(b);
+	}
+	for (HWND c = GetWindow(hDlg, GW_CHILD); c; c = GetWindow(c, GW_HWNDNEXT)) {
+		if (IsGroupBox(c)) continue;
+		if (!(GetWindowLong(c, GWL_STYLE) & WS_VISIBLE)) continue;		// the hidden stock checkbox stays out
+		const SetupHelpEntry* e = FindEntryDirect(GetDlgCtrlID(c));
+		if (!e) continue;
+		HelpItem it; GetWindowRect(c, &it.r); it.e = e;
+		POINT ctr = { (it.r.left + it.r.right) / 2, (it.r.top + it.r.bottom) / 2 };
+		HelpBox* owner = NULL;
+		for (size_t i = 0; i < boxes.size(); i++) if (PtInRect(&boxes[i].r, ctr)) { owner = &boxes[i]; break; }
+		if (owner) owner->items.push_back(it); else loose.push_back(it);
+	}
+	std::sort(boxes.begin(), boxes.end(), BoxBefore);
+	for (size_t i = 0; i < boxes.size(); i++) std::sort(boxes[i].items.begin(), boxes[i].items.end(), ItemBefore);
+	std::sort(loose.begin(), loose.end(), ItemBefore);
+
+	char nb[32];
+	std::string body = "\\fs"; _itoa_s(bodyHalfPt, nb, 10); body += nb; body += " ";
+	std::string head = "\\fs"; _itoa_s(headHalfPt, nb, 10); head += nb; head += " ";
+
+	std::string rtf = "{\\rtf1\\ansi\\deff0{\\fonttbl{\\f0\\fswiss Segoe UI;}}\\f0" + body;
+	rtf += head + "\\b "; RtfEscape(rtf, s_generalTitle); rtf += "\\b0" + body + "\\par ";
+	RtfEscape(rtf, "Every setting of this dialog, in the order it appears. The ? button in the title bar and F1 show the same text for one setting at a time.");
+	rtf += "\\par\\par ";
+
+	for (size_t i = 0; i < boxes.size(); i++) {
+		const HelpBox& b = boxes[i];
+		rtf += head + "\\b "; RtfEscape(rtf, b.caption.c_str()); rtf += "\\b0" + body + "\\par ";
+		const SetupHelpGroup* g = FindGroup(b.caption.c_str());
+		if (g) { RtfEscape(rtf, g->text); rtf += "\\par\\par "; }
+		for (size_t k = 0; k < b.items.size(); k++) {
+			rtf += "\\b "; RtfEscape(rtf, b.items[k].e->title); rtf += "\\b0\\par ";
+			RtfEscape(rtf, b.items[k].e->text); rtf += "\\par\\par ";
+		}
+	}
+	if (!loose.empty()) {
+		rtf += head + "\\b Other settings\\b0" + body + "\\par ";
+		RtfEscape(rtf, "The switches and buttons that sit outside the group boxes.");
+		rtf += "\\par\\par ";
+		for (size_t k = 0; k < loose.size(); k++) {
+			rtf += "\\b "; RtfEscape(rtf, loose[k].e->title); rtf += "\\b0\\par ";
+			RtfEscape(rtf, loose[k].e->text); rtf += "\\par\\par ";
+		}
+	}
+	rtf += "}";
+	return rtf;
+}
+
+struct RtfSource { const std::string* s; size_t pos; };
+static DWORD CALLBACK RtfStreamIn(DWORD_PTR cookie, LPBYTE buf, LONG cb, LONG* pcb)
+{
+	RtfSource* src = (RtfSource*)cookie;
+	size_t left = src->s->size() - src->pos;
+	size_t n = ((size_t)cb < left) ? (size_t)cb : left;
+	if (n) memcpy(buf, src->s->data() + src->pos, n);
+	src->pos += n; *pcb = (LONG)n;
+	return 0;
+}
+
+static void HelpWinLayout(HWND hWnd)
+{
+	if (!s_hEdit) return;
+	RECT rc; GetClientRect(hWnd, &rc);
+	MoveWindow(s_hEdit, 0, 0, rc.right, rc.bottom, TRUE);
+	int inset = DialogFontPx(hWnd) ;			// a font-height margin inside the text area
+	RECT rt = { inset, inset / 2, rc.right - inset - GetSystemMetrics(SM_CXVSCROLL), rc.bottom };
+	SendMessage(s_hEdit, EM_SETRECT, 0, (LPARAM)&rt);
+}
+
+static LRESULT CALLBACK HelpWinProc(HWND hWnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
+{
+	switch (uMsg) {
+	case WM_SIZE:
+		HelpWinLayout(hWnd);
+		return 0;
+	case WM_SETFOCUS:
+		if (s_hEdit) SetFocus(s_hEdit);
+		return 0;
+	case WM_CLOSE:
+		DestroyWindow(hWnd);
+		return 0;
+	case WM_DESTROY:
+		GetWindowRect(hWnd, &s_winRect);
+		s_hWin = NULL; s_hEdit = NULL;
+		oapiWriteLogV("D3D9: ORO setup help - window closed");
+		return 0;
+	}
+	return DefWindowProc(hWnd, uMsg, wParam, lParam);
+}
+
+void SetupHelpWindow(HWND hDlg)
+{
+	if (s_hWin && IsWindow(s_hWin)) {
+		SetWindowPos(s_hWin, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_SHOWWINDOW);
+		SetFocus(s_hWin);
+		return;
+	}
+	static HMODULE hRichEd = NULL;
+	if (!hRichEd) hRichEd = LoadLibraryA("riched20.dll");		// the Credits dialog loads it too; harmless twice
+
+	static bool registered = false;
+	if (!registered) {
+		WNDCLASSEXA wc; ZeroMemory(&wc, sizeof(wc));
+		wc.cbSize = sizeof(wc);
+		wc.style = CS_HREDRAW | CS_VREDRAW;
+		wc.lpfnWndProc = HelpWinProc;
+		wc.hInstance = g_hInst;
+		wc.hCursor = LoadCursor(NULL, IDC_ARROW);
+		wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);
+		wc.lpszClassName = s_winClass;
+		registered = (RegisterClassExA(&wc) != 0) || (GetLastError() == ERROR_CLASS_ALREADY_EXISTS);
+		if (!registered) { oapiWriteLogV("D3D9: ORO setup help - window class registration FAILED (%lu)", GetLastError()); return; }
+	}
+
+	// Size: about 62 average characters of the body font wide, three quarters of the
+	// work area tall; beside the dialog if there is room, over it otherwise.
+	const int basePx = DialogFontPx(hDlg);
+	MONITORINFO mi; mi.cbSize = sizeof(mi);
+	GetMonitorInfo(MonitorFromWindow(hDlg, MONITOR_DEFAULTTONEAREST), &mi);
+	const RECT& wa = mi.rcWork;
+	int w = (int)(basePx * s_bodyScale * 0.55 * 62) + 4 * basePx;
+	int h = (wa.bottom - wa.top) * 3 / 4;
+	RECT rd; GetWindowRect(hDlg, &rd);
+	int x = rd.right + 8, y = rd.top;
+	if (x + w > wa.right) x = rd.left + (rd.right - rd.left - w) / 2;
+	if (x < wa.left) x = wa.left;
+	if (y + h > wa.bottom) y = wa.bottom - h;
+	if (y < wa.top) y = wa.top;
+	if (s_winRect.right > s_winRect.left && s_winRect.bottom > s_winRect.top) {
+		x = s_winRect.left; y = s_winRect.top;
+		w = s_winRect.right - s_winRect.left; h = s_winRect.bottom - s_winRect.top;
+	}
+
+	s_hWin = CreateWindowExA(0, s_winClass, "D3D9Client Advanced Setup - Help",
+	                         (WS_OVERLAPPEDWINDOW & ~WS_MAXIMIZEBOX) | WS_CLIPCHILDREN,
+	                         x, y, w, h, hDlg, NULL, g_hInst, NULL);
+	if (!s_hWin) { oapiWriteLogV("D3D9: ORO setup help - window creation FAILED (%lu)", GetLastError()); return; }
+
+	s_hEdit = CreateWindowExA(0, "RichEdit20A", "",
+	                          WS_CHILD | WS_VISIBLE | WS_VSCROLL | ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL,
+	                          0, 0, 10, 10, s_hWin, NULL, g_hInst, NULL);
+	if (!s_hEdit) {
+		oapiWriteLogV("D3D9: ORO setup help - rich edit creation FAILED (%lu)", GetLastError());
+		DestroyWindow(s_hWin); return;
+	}
+	SendMessage(s_hEdit, EM_SETBKGNDCOLOR, 0, (LPARAM)GetSysColor(COLOR_WINDOW));
+	HelpWinLayout(s_hWin);
+
+	// Font sizes in half-points, from the same pixel heights the popup uses.
+	HDC hdc = GetDC(hDlg);
+	int dpi = GetDeviceCaps(hdc, LOGPIXELSY); if (dpi <= 0) dpi = 96;
+	ReleaseDC(hDlg, hdc);
+	int bodyHalfPt = (int)(basePx * s_bodyScale * 72.0 / dpi * 2.0 + 0.5);
+	int headHalfPt = (int)(basePx * s_headScale * 72.0 / dpi * 2.0 + 0.5);
+
+	std::string rtf = BuildHelpRtf(hDlg, bodyHalfPt, headHalfPt);
+	RtfSource src = { &rtf, 0 };
+	EDITSTREAM es; ZeroMemory(&es, sizeof(es));
+	es.dwCookie = (DWORD_PTR)&src;
+	es.pfnCallback = RtfStreamIn;
+	SendMessage(s_hEdit, EM_STREAMIN, SF_RTF, (LPARAM)&es);
+	SendMessage(s_hEdit, EM_SETSEL, 0, 0);
+	SendMessage(s_hEdit, EM_SCROLLCARET, 0, 0);
+
+	ShowWindow(s_hWin, SW_SHOW);
+	SetFocus(s_hEdit);
+	oapiWriteLogV("D3D9: ORO setup help - window opened at %d,%d (%d x %d), %u bytes of text", x, y, w, h, (unsigned)rtf.size());
+}
+
+// ---------------------------------------------------------------------------
+// Entry points
+// ---------------------------------------------------------------------------
+
+void SetupHelpClose() { PopupClose("closed by the dialog"); }
+
+void SetupHelpShow(HWND hDlg, const HELPINFO* hi)
+{
+	if (!hi || hi->iContextType != HELPINFO_WINDOW) return;
+	s_pending = *hi;
+	s_pendingValid = true;
+	PostMessage(hDlg, WM_ORO_SETUPHELP, 0, 0);	// rule 1: show AFTER the help mode / key handling has unwound
+}
+
+void SetupHelpDeferred(HWND hDlg)
+{
+	if (!s_pendingValid) return;
+	s_pendingValid = false;
+	const HELPINFO hi = s_pending;
+
+	HWND hItem = (HWND)hi.hItemHandle;
+	const char* title = s_generalTitle;
+	const char* text = s_generalText;
+	RECT anchor;
+
+	if (!hItem || hItem == hDlg || !IsWindow(hItem)) {
+		// The dialog background: a general note at the click point.
+		anchor.left = anchor.right = hi.MousePos.x;
+		anchor.top = anchor.bottom = hi.MousePos.y;
+		PopupShow(hDlg, &anchor, title, text);
+		return;
+	}
+
+	const SetupHelpEntry* e = FindEntry(GetDlgCtrlID(hItem));
+	HWND hAnchor = hItem;
+	if (!e) {
+		if (IsGroupBox(hItem)) {
+			char caption[128] = "";
+			GetWindowTextA(hItem, caption, sizeof(caption));
+			const SetupHelpGroup* g = FindGroup(caption);
+			if (g) { title = g->caption; text = g->text; }
+			// anchor at the click, a group box is large
+			anchor.left = anchor.right = hi.MousePos.x;
+			anchor.top = anchor.bottom = hi.MousePos.y;
+			PopupShow(hDlg, &anchor, title, text);
+			return;
+		}
