+sampler LclShmS = sampler_state
+{
+	Texture = <gLclShmTex>;
+	MinFilter = POINT;
+	MagFilter = POINT;
+	MipFilter = NONE;
+	AddressU = CLAMP;
+	AddressV = CLAMP;
