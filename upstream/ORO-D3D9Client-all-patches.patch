+	// the same tap with the flag written after the early return compiled correctly in a
+	// 40-slot probe, but this shape is 12 slots cheaper and leaves the compiler nothing to
+	// reorder around a return)
+	float  ok = (on >= 0.5f && all(sp >= 0.0f) && all(sp <= 1.0f) && z >= 0.0f && z <= 1.0f) ? 1.0f : 0.0f;
+	inside = ok;
