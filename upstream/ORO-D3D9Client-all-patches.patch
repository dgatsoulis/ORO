+void D3D9Triangle::UpdateTex(const gcCore::texVtx *pt, int npt, const float *pDepth)
+{
+	SkpVtx *Vtx = NULL;
+	HR(pVB->Lock(0, 0, (LPVOID*)&Vtx, D3DLOCK_DISCARD));
