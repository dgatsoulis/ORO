+float  g_gcFogTop[2]   = { 0.0f, 0.0f };   // thickness per layer, m (0 = off)
+float  g_gcFogScale[2] = { 1.0f, 1.0f };   // density scale height per layer, m
+float  g_gcFogDens[2]  = { 0.0f, 0.0f };   // extinction at the base per layer, 1/m
