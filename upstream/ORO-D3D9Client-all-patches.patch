+	float  hc   = frac(sin(dot(cell, float2(127.1f, 311.7f))) * 43758.5453f);
+	float  uu   = gWetTime * (1.0f / 0.55f) + hc;      // the splash-ring cadence
+	float  ep   = floor(uu);
+	float  tt   = frac(uu);
+	float  h2   = frac(sin(dot(cell + ep * 7.13f, float2(269.5f, 183.3f))) * 43758.5453f);
