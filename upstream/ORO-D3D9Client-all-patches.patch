 	return float4(clr.rgb*frg.atten.rgb+frg.insca.rgb, cTex.a);
 	//return float4(clr.rgb*frg.atten.rgb+frg.insca.rgb, cTex.a*(1-frg.insca.a));	// Make basetiles transparent during night
 }
