+// The side copy to the device, lazily and only when it changed - MeshBuffer::Map's own shape,
+// default pool, released with the mesh.
+void D3D9Mesh::RimMap()
+{
+	if (!bRimRemap) return;
+	bRimRemap = false;
+	RimRelease();
+	if (rimVtx.empty() || rimIdx.empty()) return;
+	if (FAILED(pDev->CreateVertexBuffer((UINT)(rimVtx.size() * sizeof(NMVERTEX)), 0, 0, D3DPOOL_DEFAULT, &pRimVB, NULL))) { pRimVB = NULL; return; }
+	if (FAILED(pDev->CreateIndexBuffer((UINT)(rimIdx.size() * sizeof(WORD)), 0, D3DFMT_INDEX16, D3DPOOL_DEFAULT, &pRimIB, NULL))) { pRimIB = NULL; RimRelease(); return; }
+	LPVOID p = NULL;
+	if (SUCCEEDED(pRimVB->Lock(0, 0, &p, 0))) { memcpy(p, &rimVtx[0], rimVtx.size() * sizeof(NMVERTEX)); pRimVB->Unlock(); }
+	if (SUCCEEDED(pRimIB->Lock(0, 0, &p, 0))) { memcpy(p, &rimIdx[0], rimIdx.size() * sizeof(WORD)); pRimIB->Unlock(); }
+}
+
+void D3D9Mesh::RimRelease()
+{
+	SAFE_RELEASE(pRimVB);
+	SAFE_RELEASE(pRimIB);
+}
