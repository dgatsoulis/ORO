+	float  h2 = frac(sin(dot(c, float2(269.5f, 183.3f))) * 43758.5453f);
+	float  h3 = frac(sin(dot(c, float2(419.2f, 371.9f))) * 43758.5453f);
+	float2 at = float2(0.2f + 0.6f * frac(h2 * 7.31f), 0.2f + 0.6f * frac(h3 * 5.17f));   // its place in the cell
