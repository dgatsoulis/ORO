+	for (int i = 0; i < g_rainCfgN; i++) {
+		if (_stricmp(g_rainCfg[i].mesh, fname)) continue;
+		bool dup = false;
+		for (size_t j = 0; j < grps.size(); j++) if (grps[j] == g_rainCfg[i].grp) { dup = true; break; }
