+static const SetupHelpEntry* FindEntry(int id)
+{
+	for (size_t i = 0; i < sizeof(g_aliases) / sizeof(g_aliases[0]); i++)
+		if (g_aliases[i].id == id) { id = g_aliases[i].target; break; }
+	for (size_t i = 0; i < sizeof(g_entries) / sizeof(g_entries[0]); i++)
+		if (g_entries[i].id == id) return &g_entries[i];
+	return NULL;
+}
+
+static const SetupHelpGroup* FindGroup(const char* caption)
+{
+	for (size_t i = 0; i < sizeof(g_groups) / sizeof(g_groups[0]); i++)
+		if (strcmp(g_groups[i].caption, caption) == 0) return &g_groups[i];
+	return NULL;
+}
+
+const char* SetupHelpText(int ctrlId, const char** pTitle)
+{
+	const SetupHelpEntry* e = FindEntry(ctrlId);
+	if (pTitle) *pTitle = e ? e->title : NULL;
+	return e ? e->text : NULL;
+}
