+	if (mat->Diffuse.z > dmax) dmax = mat->Diffuse.z;
+	if (dmax < 0.05f) return mat;                    // a display: its emissive IS the picture
+	s_oroNightMat = *mat;
+	s_oroNightMat.Emissive *= g_oroVCNightNow;
