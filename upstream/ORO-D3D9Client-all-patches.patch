+	float3 f  = normalize(nrmW + (float3(h1, h2, h3) - 0.5f) * 0.8f);
+	float3 H  = normalize(toCam + toSun);
+	return step(h1, 0.25f * k) * spot * fade * pow(saturate(dot(H, f)), 200.0f) * saturate(dot(nrmW, toSun) * 3.0f);
