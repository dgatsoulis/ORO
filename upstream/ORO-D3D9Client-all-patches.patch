@@ -0,0 +1,41 @@
+// ==============================================================
+// ORO patch (am): context help for the "D3D9Client Advanced Setup" dialog.
+//
+// The dialog carries WS_EX_CONTEXTHELP, so Windows gives it the "?" title-bar
+// button and F1 for free: both arrive as WM_HELP with a HELPINFO naming the
+// control that was clicked or focused. SetupHelpShow() resolves that control
+// to an entry in the table in SetupHelp.cpp and shows the entry in a small
+// popup beside it. No buttons, no tooltips, no help window - the popup is the
+// whole interface. tools/setuphelpcheck.py refuses a build in which any
+// control of the dialog has no entry.
+//
+// Part of the ORO build of D3D9Client (https://github.com/dgatsoulis/orbiter-oro).
+// Licensed under LGPL v3, like the rest of the client.
+// ==============================================================
+
+#pragma once
+#include <windows.h>
+
+/// Private message the WM_HELP handler posts to the dialog: the popup is created
+/// when THIS arrives, after the system's help mode and the key handling have
+/// unwound (creating it inside WM_HELP itself gets it torn down at once).
+#define WM_ORO_SETUPHELP (WM_APP + 0x0A5)
+
+/// Record the WM_HELP's HELPINFO and post WM_ORO_SETUPHELP to the dialog.
+/// hDlg is the Advanced Setup dialog; the popup is owned by it and dies with it.
+void SetupHelpShow(HWND hDlg, const HELPINFO* hi);
+
+/// The dialog's handler for WM_ORO_SETUPHELP: resolves the recorded control to
+/// its entry and shows the popup.
+void SetupHelpDeferred(HWND hDlg);
+
+/// The Help button: open (or raise) the modeless window that carries every entry
+/// as one document, in the dialog's own layout order. Owned by the dialog.
+void SetupHelpWindow(HWND hDlg);
+
+/// Close the popup if one is open (safe to call when none is).
+void SetupHelpClose();
+
+/// Look an entry up by control id. Returns the body text and, through pTitle,
+/// the title; NULL when the id has no entry (aliases are followed).
+const char* SetupHelpText(int ctrlId, const char** pTitle);
